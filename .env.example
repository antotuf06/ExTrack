# Copy this file to data/.env and fill in the values.
# data/ is git-ignored: real values must never be committed.

# ─── Paths (relative to the project root, or absolute) ──────────────────────
DATA_DIR=data
DATABASE_PATH=data/spese.sqlite
# Point this to an external drive or a synced folder (design §13).
BACKUP_DIR=data/backups
BACKUP_RETENTION=30

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8000
# false = listen on 127.0.0.1 only (default).
# true  = listen on 0.0.0.0 for phones on the home Wi-Fi: login becomes mandatory.
LISTEN_LAN=false
LOG_LEVEL=INFO

# ─── Domain ─────────────────────────────────────────────────────────────────
# Excel/bank cutoff date (D19, still to confirm: 2026-08-01 or 2026-09-01).
# Before it the Excel history wins, from it onward the bank statements win.
CUTOFF_DATE=2026-08-01

# Account holder names (comma-separated), used to recognise transfers between
# own accounts in bank statements (design §8.2.1). Never put them in code.
ACCOUNT_HOLDER_NAMES=

# ─── Phase 3: Enable Banking (leave empty until then) ───────────────────────
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_KEY_PATH=data/enable-banking.pem
