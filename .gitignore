# ─── Personal data: NEVER commit ────────────────────────────────────────────
# Database, backups and secrets live in data/ (see CLAUDE.md).
data/*
!data/.gitkeep
.env
.env.*
!.env.example
*.sqlite
*.sqlite3
*.db
*.pem
*.key

# Real source files (Excel history, bank statements, CSV exports) must never
# enter the repository. Test fixtures are generated by scripts at test time.
*.xlsx
*.xlsm
*.xls
*.pdf
*.csv
*.ods

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Frontend ───────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
.vite/

# ─── Editors / OS ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Claude Code (local settings only) ──────────────────────────────────────
.claude/settings.local.json
